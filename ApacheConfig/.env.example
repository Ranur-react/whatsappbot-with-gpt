# ====================================
# APACHE CONFIGURATION ENVIRONMENT TEMPLATE
# ====================================
# Copy this file to .env and modify values according to your setup
# DO NOT COMMIT .env FILE TO GIT REPOSITORY!

# Domain dan Server Configuration
DOMAIN_NAME=your-domain.com
SERVER_IP=your.server.ip.address
ADMIN_EMAIL=admin@your-domain.com

# Docker Configuration
DOCKER_CONTAINER_NAME=node1
DOCKER_INTERNAL_PORT=3000
DOCKER_SERVICE_NAME=whatsapp-webhook

# Apache Proxy Configuration
TARGET_PORT=3000

# SSL Configuration
ENABLE_SSL=true
SSL_AUTO_REDIRECT=true

# Security Configuration
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=true

# Monitoring Configuration
ENABLE_SERVER_STATUS=true
ALLOWED_MONITOR_IPS=127.0.0.1,your.server.ip.address

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Logging Configuration
LOG_LEVEL=info
ENABLE_ACCESS_LOG=true
ENABLE_ERROR_LOG=true

# Development Options (set to false for production)
DEBUG_MODE=false
SKIP_SSL_VERIFICATION=false
